{
  "name": "fcsl-hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "hrm:account": "tsx scripts/create-account.ts",
    "hrm:approve": "tsx scripts/approve-joiner.ts",
    "hrm:org": "tsx scripts/seed-org.ts",
    "hrm:role": "tsx scripts/set-role.ts",
    "hrm:import": "tsx scripts/import-employees.ts",
    "qa:panel1": "tsx scripts/qa-panel1.ts",
    "qa:leave": "tsx scripts/qa-leave.ts",
    "qa:chain": "tsx scripts/qa-chain.ts",
    "qa": "npm run qa:clean && npm run qa:leave && npm run qa:chain && npm run qa:exit && npm run qa:compliance && npm run qa:regressions",
    "qa:clean": "tsx scripts/qa-clean.ts",
    "qa:exit": "tsx scripts/qa-exit.ts",
    "qa:import": "tsx scripts/qa-import.ts",
    "qa:compliance": "tsx scripts/qa-compliance.ts",
    "qa:regressions": "cross-env PRISMA_LOG_QUERIES=1 tsx scripts/qa-regressions.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.11",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "braces": "^3.0.3"
  }
}
