{
  "name": "fcsl-hrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "hrm:account": "tsx scripts/create-account.ts",
    "hrm:approve": "tsx scripts/approve-joiner.ts",
    "hrm:org": "tsx scripts/seed-org.ts",
    "hrm:role": "tsx scripts/set-role.ts",
    "hrm:import": "tsx scripts/import-employees.ts",
    "qa:panel1": "tsx scripts/qa-panel1.ts",
    "qa:leave": "tsx scripts/qa-leave.ts",
    "qa:chain": "tsx scripts/qa-chain.ts",
    "qa": "npm run qa:leave && npm run qa:chain"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "eslint-config-next": "^16.3.4",
    "jose": "^6.0.11",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.12.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
