# FCSL HR Management System — environment variables
#
# Copy to `.env` for local work, and paste the same values into
# Vercel → Project → Settings → Environment Variables for the live site.
# `.env` is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Database — Supabase → Project Settings → Database → Connection string
#
# TWO urls, and they are not interchangeable.
#
# DATABASE_URL is what the app uses on every request: the "Transaction pooler"
# URI, port 6543. A connection is borrowed for one query and handed straight
# back, so many serverless invocations share a small pool.
#
#   pgbouncer=true     transaction pooling does not keep prepared statements
#                      between queries, so Prisma must stop using them
#   connection_limit=5 how many connections one instance may hold
#
# DIRECT_URL is used only by `prisma migrate`, from a laptop or a deploy step —
# never from a request. Migrations need a connection that survives more than
# one statement, which the transaction pooler does not give. Port 5432.
#
# Do NOT point DATABASE_URL at 5432. That is session mode, and it has already
# taken the sister project down once. It presents as an authorisation bug.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Session signing key. At least 32 random characters. The app refuses to start
# in production without it — anyone who knows this value can forge a Super
# Admin login. Generate one with:  openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# The first Super Admin, created once at installation by `npm run db:seed`.
# Seeding skips the account entirely when ADMIN_PASSWORD is unset, and never
# touches the account if the email already exists. Minimum 12 characters.
#
# §3 of the spec requires that the fact this account was created outside the
# normal approval chain is itself written into the permanent record. It is.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ---------------------------------------------------------------------------
# Public address of the site. Used in email links. No trailing slash.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email. Leave SMTP_HOST empty and messages are printed to the server log
# instead of being sent — the system still works, nobody is notified. That is
# the correct behaviour in development: never mail a real employee from a
# laptop.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="FCSL HR <hr@fcslbd.com>"

# ---------------------------------------------------------------------------
# Document storage — Supabase → Project Settings → API.
#
# Required in production: Vercel's filesystem is wiped on every deploy, so
# uploads written to disk would be lost. With these unset the app falls back to
# a local `storage/` folder, which is for development only and is git-ignored
# because it would otherwise contain real scanned NIDs.
#
# The service role key bypasses row-level security — server-side use only,
# never exposed to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="hrm-documents"

# ---------------------------------------------------------------------------
# Shared secret for the scheduled jobs in app/api/cron. Vercel Cron sends it as
# a bearer token.
#
# LEAVING THIS BLANK STOPS THE JOBS RUNNING — the endpoint answers 404 to every
# caller, including Vercel. That is the correct failure for a deploy that
# forgot the variable: no reminders, loudly, rather than an open endpoint that
# anybody could use to trigger the document purge.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# Turn every database query into an event, for counting them.
#
# Off unless set to 1, and ignored in production. Rule 7 ("every list is paged;
# every count is capped") and the N+1 behind the approvals inbox are both
# claims about how many queries a screen runs, and a claim like that ought to
# be measurable rather than argued:
#
#   PRISMA_LOG_QUERIES=1 npm run qa:regressions
#
# reports the real numbers instead of asserting them.
PRISMA_LOG_QUERIES=
